# ============================================
# Azmyra — Meeting Bot / Agent Service
# ============================================

FROM python:3.11-slim

WORKDIR /app

COPY meeting-bot/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY meeting-bot/ .

ENV PORT 8080
EXPOSE 8080

CMD uvicorn app:app --host 0.0.0.0 --port $PORT
