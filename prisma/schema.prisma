generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ Authentication ============
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("member") // admin, member, viewer
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts    Account[]
  sessions    Session[]
  initiatives Initiative[]
  meetings    Meeting[]
  risks       Risk[]
  chatMessages ChatMessage[]
  settings    UserSettingsRecord?
  onboarding     OnboardingProgress?
  shareLinks     ShareLink[]
  pendingActions PendingAction[]
  knowledgeDocs  KnowledgeDocument[]

  // Market Intelligence
  marketResearches MarketResearch[]
  contentVersions  ContentVersion[]
  dataConnectors   DataConnectorConfig[]
  dataJobs         DataJob[]

  // Vision Pillar (Azmyra 3.0)
  northStar        NorthStar?
  businessGoals    BusinessGoal[]
  targetGroups     TargetGroup[]
  needs            Need[]
  productMappings  ProductMapping[]
  visionComplete   Boolean  @default(false)

  // Competitors Eye
  competitors      Competitor[]
  competitorFeeds  CompetitorFeed[]

  // Alignment & Impact
  alignmentScores  AlignmentScore[]
  businessImpacts  BusinessImpact[]

  // Autonomous AI
  cronJobs         CronJob[]
  cronRuns         CronRun[]
  alerts           UserAlert[]

  // Session Continuity
  chatSessions     ChatSession[]

  // Brain Graph (Big Picture)
  brainNodes       BrainNode[]

  // Proactive Intelligence (Sprint 3)
  proactiveInsights ProactiveInsight[]
  watchTopics       WatchTopic[]

  // Agent Collaboration (Sprint 4)
  agentMessages     AgentMessage[]

  // Integration Connections (Sprint 5)
  integrationConnections IntegrationConnection[]

  // Product Verticals (Sprint Architecture)
  productVerticals ProductVertical[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ Settings (encrypted credentials) ============
model UserSettingsRecord {
  id                String @id @default(cuid())
  userId            String @unique
  llmProvider       String @default("openai")
  llmModel          String @default("")
  llmApiKey         String @default("") // encrypted
  llmApiEndpoint    String @default("")
  autonomyLevel     String @default("oversight")
  notificationsEnabled Boolean @default(true)
  autoSendEmails    Boolean @default(false)
  autoCreateJira    Boolean @default(true)
  theme             String @default("system")

  // Integration credentials (encrypted)
  jiraEnabled       Boolean @default(false)
  jiraUrl           String  @default("")
  jiraEmail         String  @default("")
  jiraApiToken      String  @default("") // encrypted
  slackEnabled      Boolean @default(false)
  slackBotToken     String  @default("") // encrypted
  slackChannelId    String  @default("")
  confluenceEnabled Boolean @default(false)
  confluenceUrl     String  @default("")
  confluenceEmail   String  @default("")
  confluenceApiToken String @default("") // encrypted
  emailEnabled      Boolean @default(false)
  smtpHost          String  @default("")
  smtpPort          Int     @default(587)
  smtpUsername      String  @default("")
  smtpPassword      String  @default("") // encrypted
  smtpFromEmail     String  @default("")

  // Zoom meeting bot credentials
  zoomEnabled       Boolean @default(false)
  zoomAccountId     String  @default("")
  zoomClientId      String  @default("")
  zoomClientSecret  String  @default("") // encrypted

  // Teams meeting bot credentials
  teamsEnabled      Boolean @default(false)
  teamsClientId     String  @default("")
  teamsTenantId     String  @default("")
  teamsClientSecret String  @default("") // encrypted

  // Notion
  notionAccessToken  String @default("") // encrypted

  // Linear
  linearApiKey       String @default("") // encrypted

  // GitHub
  githubAccessToken  String @default("") // encrypted
  githubOrgName      String @default("")

  // Analytics
  mixpanelProjectId  String @default("")
  mixpanelSecret     String @default("") // encrypted
  amplitudeApiKey    String @default("") // encrypted
  ga4PropertyId      String @default("")
  ga4CredentialsJson String @default("") // encrypted, JSON stored as string

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Initiatives ============
model Initiative {
  id            String   @id @default(cuid())
  title         String
  description   String   @default("")
  status        String   @default("idea") // idea, discovery, validation, definition, approved
  businessValue String   @default("medium") // high, medium, low
  effort        String   @default("medium") // high, medium, low
  stakeholders  String   @default("[]") // JSON array
  tags          String   @default("[]") // JSON array
  risks         String   @default("[]") // JSON array
  dependencies  String   @default("[]") // JSON array
  jiraKey       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Azmyra 3.0 Strategy extensions
  level           String?  @default("idea") // "solution" | "epic" | "idea"
  pillar          String?  @default("strategy") // "vision" | "strategy" | "tactics"
  alignmentScore  Float?   // cached VAS (0-100)
  businessImpactId String? // link to BusinessImpact
  competitiveRank  Int?    // 1-N rank vs competitors
  discovery       String   @default("{}") // JSON: { notes, aiAnalysis, status, lastUpdated }

  // Product Vertical grouping (Sprint Architecture)
  verticalId    String?
  vertical      ProductVertical? @relation(fields: [verticalId], references: [id])
  granularity   String @default("initiative") // "vertical" | "initiative" | "idea"

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([verticalId])
}

// ============ Meetings ============
model Meeting {
  id           String   @id @default(cuid())
  title        String
  date         DateTime @default(now())
  duration     Int      @default(30) // minutes
  participants String   @default("[]") // JSON array
  status       String   @default("scheduled") // scheduled, completed, processing, summarized
  transcript   String?
  summary      String?
  actionItems  String   @default("[]") // JSON array of ActionItem
  decisions    String   @default("[]") // JSON array
  challenges   String   @default("[]") // JSON array
  followUpEmail  String?
  platform       String?   // "zoom" | "teams" | "manual"
  meetingUrl     String?
  botSessionId   String?
  liveTranscript String?   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Risks ============
model Risk {
  id             String   @id @default(cuid())
  title          String
  description    String   @default("")
  severity       String   @default("medium") // critical, high, medium, low
  probability    String   @default("medium") // high, medium, low
  impact         String   @default("medium") // high, medium, low
  status         String   @default("identified") // identified, mitigating, resolved, accepted
  relatedItems   String   @default("[]") // JSON array
  mitigationPlan String?

  // AI risk assessment (populated by agent)
  aiAssessment   String?   @db.Text
  aiSeverity     String?
  aiMitigation   String?   @db.Text
  assessedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Chat ============
model ChatMessage {
  id              String   @id @default(cuid())
  role            String   // user, assistant
  content         String
  metadata        String   @default("{}") // JSON
  agentId         String?  // which agent responded
  agentName       String?
  toolsExecuted   String   @default("[]") // JSON array of ToolExecution
  pendingActions  String   @default("[]") // JSON array of PendingAction refs
  sources         String   @default("[]") // JSON array of SourceAttribution
  createdAt       DateTime @default(now())

  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatSessionId String?
  chatSession   ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)

  @@index([chatSessionId])
}

// ============ Documents ============
model Document {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("other") // prd, specification, decision_log, meeting_notes, other
  content   String
  tags      String   @default("[]") // JSON array
  source    String   @default("uploaded") // uploaded, generated, synced
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ Onboarding ============
model OnboardingProgress {
  id                  String   @id @default(cuid())
  userId              String   @unique
  currentStep         Int      @default(0)
  completed           Boolean  @default(false)
  jiraConnected       Boolean  @default(false)
  confluenceConnected Boolean  @default(false)
  slackConnected      Boolean  @default(false)
  syncStarted         Boolean  @default(false)
  syncCompleted       Boolean  @default(false)
  syncLog             String   @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SyncRecord {
  id         String   @id @default(cuid())
  userId     String
  source     String
  itemType   String
  externalId String
  localId    String?
  status     String   @default("pending")
  metadata   String   @default("{}")
  createdAt  DateTime @default(now())
}

// ============ Share Links ============
model ShareLink {
  id           String   @id @default(cuid())
  token        String   @unique
  createdBy    String
  resourceType String
  resourceId   String?
  accessLevel  String   @default("view_comment")
  guestName    String?
  expiresAt    DateTime
  isActive     Boolean  @default(true)
  viewCount    Int      @default(0)
  dataSnapshot Json?
  createdAt    DateTime @default(now())

  creator  User           @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  comments ShareComment[]
}

model ShareComment {
  id            String   @id @default(cuid())
  shareLinkId   String
  guestName     String
  content       String
  targetSection String?
  createdAt     DateTime @default(now())

  shareLink ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
}

// ============ Pending Actions (Agent Autonomy) ============
model PendingAction {
  id             String   @id @default(cuid())
  userId         String
  agentId        String   // which agent proposed this action
  toolName       String   // MCP tool name
  toolArguments  String   @default("{}") // JSON
  description    String   // human-readable description of what the tool will do
  status         String   @default("pending") // pending, approved, rejected, executed
  result         String?  // execution result if approved & executed
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Knowledge Base ============
model KnowledgeDocument {
  id            String   @id @default(cuid())
  userId        String
  sourceType    String   // 'file' | 'url'
  sourceName    String   // filename or page title
  sourceUrl     String?  // URL if scraped, null if uploaded
  content       String   // full extracted text
  contentChunks String   @default("[]") // JSON array of text chunks
  fileType      String?  // pdf, docx, txt, md, csv, xlsx
  fileSize      Int?     // bytes
  metadata      String?  // JSON: fetchedAt, domain, pageCount, etc.
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Market Research ============
model MarketResearch {
  id                String   @id @default(cuid())
  userId            String
  initiativeId      String?
  title             String
  query             String
  status            String   @default("pending") // pending, gathering, synthesizing, completed, failed
  synthesizedReport String?
  reportMetadata    String   @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  dataPoints DataPoint[]
}

model DataPoint {
  id             String    @id @default(cuid())
  researchId     String
  adapterKey     String
  sourceUrl      String
  sourceName     String
  title          String    @default("")
  rawContent     String
  contentType    String    @default("article")
  extractedFacts String    @default("[]")
  publishedAt    DateTime?
  fetchedAt      DateTime  @default(now())
  metadata       String    @default("{}")

  research MarketResearch @relation(fields: [researchId], references: [id], onDelete: Cascade)

  @@index([researchId, adapterKey])
}

model ContentVersion {
  id                String   @id @default(cuid())
  userId            String
  entityType        String
  entityId          String
  content           String
  editedBy          String   @default("ai")
  changeDescription String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model DataConnectorConfig {
  id              String    @id @default(cuid())
  userId          String
  type            String    // preset, custom
  name            String
  adapterKey      String
  config          String    @default("{}")
  dataMapping     String    @default("{}")
  refreshSchedule String    @default("manual")
  isActive        Boolean   @default(true)
  lastFetchAt     DateTime?
  lastFetchStatus String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============ Async Job Queue ============
model DataJob {
  id          String    @id @default(cuid())
  userId      String
  jobType     String
  status      String    @default("pending") // pending, running, completed, failed
  input       String    @default("{}")
  output      String?
  error       String?
  progress    Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([jobType, status])
}

// ============================================
// VISION PILLAR MODELS (Azmyra 3.0)
// ============================================

model NorthStar {
  id          String   @id @default(cuid())
  userId      String   @unique
  statement   String
  context     String?  @db.Text
  confidence  Float    @default(0)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessGoals BusinessGoal[]

  @@index([userId])
}

model BusinessGoal {
  id          String    @id @default(cuid())
  userId      String
  northStarId String
  title       String
  description String?   @db.Text
  metric      String?
  target      String?
  deadline    DateTime?
  priority    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  northStar    NorthStar     @relation(fields: [northStarId], references: [id], onDelete: Cascade)
  targetGroups TargetGroup[]

  @@index([userId])
  @@index([northStarId])
}

model TargetGroup {
  id             String   @id @default(cuid())
  userId         String
  businessGoalId String?
  name           String
  description    String?  @db.Text
  role           String?
  demographics   String?  @db.Text
  behaviors      String?  @db.Text
  goals          String?  @db.Text
  painPoints     String?  @db.Text
  source         String   @default("manual") // "manual" | "ai_generated" | "onboarding"

  // JTBD Layer
  jtbdStatement    String @default("")
  jtbdFunctional   String @default("[]") // JSON array — JSON.parse() on read
  jtbdEmotional    String @default("[]") // JSON array — JSON.parse() on read
  jtbdSocial       String @default("[]") // JSON array — JSON.parse() on read

  // Empathy Map Layer
  empathyThinks    String @default("[]") // JSON array — JSON.parse() on read
  empathySays      String @default("[]") // JSON array — JSON.parse() on read
  empathyFeels     String @default("[]") // JSON array — JSON.parse() on read
  empathyDoes      String @default("[]") // JSON array — JSON.parse() on read

  // Behavioral Layer
  triggers           String @default("[]") // JSON array — JSON.parse() on read
  decisionDrivers    String @default("[]") // JSON array — JSON.parse() on read
  currentWorkarounds String @default("[]") // JSON array — JSON.parse() on read
  churnRisks         String @default("[]") // JSON array — JSON.parse() on read
  successMetrics     String @default("[]") // JSON array — JSON.parse() on read
  preferredChannels  String @default("[]") // JSON array — JSON.parse() on read

  // Context Layer
  companyStage    String @default("")
  teamSize        String @default("")
  industryContext String @default("")
  dayInLife       String @default("") // prose paragraph
  typicalQuote    String @default("")

  // Metadata
  confidence       Float     @default(0.8)
  lastEnrichedAt   DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessGoal BusinessGoal? @relation(fields: [businessGoalId], references: [id], onDelete: Cascade)
  needs        Need[]

  @@unique([userId, name], name: "userId_name")
  @@index([userId])
  @@index([businessGoalId])
}

model Need {
  id            String   @id @default(cuid())
  userId        String
  targetGroupId String
  title         String
  description   String?  @db.Text
  severity      Int      @default(5)
  frequency     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetGroup TargetGroup      @relation(fields: [targetGroupId], references: [id], onDelete: Cascade)
  products    ProductMapping[]

  @@index([userId])
  @@index([targetGroupId])
}

model ProductMapping {
  id        String   @id @default(cuid())
  userId    String
  needId    String
  name      String
  type      String   // "existing" | "planned" | "idea"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  need Need @relation(fields: [needId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([needId])
}

// ============================================
// COMPETITORS EYE MODELS
// ============================================

model Competitor {
  id          String   @id @default(cuid())
  userId      String
  name        String
  website     String?
  description String?  @db.Text
  tags        String?  // JSON array: ["direct", "indirect", "emerging"]
  isActive    Boolean  @default(true)

  // AI market analysis (populated by LLM from scraped data)
  estimatedMarketCap  String?
  estimatedUsers      String?
  marketTrend         String?   // "growing" | "stable" | "declining"
  predictedGrowth     Float?
  marketAnalysis      String?   @db.Text
  marketAnalysisAt    DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  feeds CompetitorFeed[]

  @@index([userId])
}

model CompetitorFeed {
  id            String    @id @default(cuid())
  userId        String
  competitorId  String
  type          String    // "news" | "product_update" | "vision_shift" | "rumor" | "pricing" | "hiring"
  title         String
  summary       String    @db.Text
  source        String?
  sourceAdapter String?
  relevance     Float     @default(0.5)
  sentiment     String?   // "positive" | "negative" | "neutral"
  raw           String?   @db.Text
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  competitor Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([competitorId])
  @@index([createdAt])
  @@index([type])
}

// ============================================
// VISION ALIGNMENT SCORING
// ============================================

model AlignmentScore {
  id                   String   @id @default(cuid())
  userId               String
  entityType           String   // "initiative" | "strategy_item" | "risk"
  entityId             String
  overallScore         Float
  northStarRelevance   Float
  businessGoalCoverage Float
  targetGroupImpact    Float
  needFulfillment      Float
  reasoning            String?  @db.Text
  computedBy           String   @default("ai")
  version              Int      @default(1)
  createdAt            DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([overallScore])
}

// ============================================
// BUSINESS IMPACT MODEL
// ============================================

model BusinessImpact {
  id               String   @id @default(cuid())
  userId           String
  entityType       String   // "initiative"
  entityId         String
  revenueEstimate  Float?
  roiPercent       Float?
  timeToValueWeeks Int?
  marketShareDelta Float?
  confidenceLevel  String?  // "low" | "medium" | "high"
  assumptions      String?  @db.Text
  computedBy       String   @default("ai")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([entityType, entityId])
}

// ============================================
// AUTONOMOUS CRON SYSTEM
// ============================================

model CronJob {
  id          String    @id @default(cuid())
  userId      String
  jobType     String    // "competitor_scan" | "strategy_eval" | "risk_reassess" | "market_pulse" | "full_portfolio_review"
  schedule    String    // cron expression
  lastRun     DateTime?
  nextRun     DateTime?
  status      String    @default("active") // "active" | "paused" | "failed"
  lastResult  String?   @db.Text
  lastError   String?   @db.Text
  runCount    Int       @default(0)
  config      String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobType])
  @@index([nextRun])
  @@index([status])
}

model CronRun {
  id         String    @id @default(cuid())
  userId     String
  jobType    String
  status     String    // "running" | "completed" | "failed"
  startedAt  DateTime  @default(now())
  endedAt    DateTime?
  result     String?   @db.Text
  error      String?   @db.Text
  duration   Int?      // milliseconds
  tokensUsed Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobType])
  @@index([startedAt])
}

// ============================================
// USER ALERTS (from autonomous AI)
// ============================================

model UserAlert {
  id          String    @id @default(cuid())
  userId      String
  type        String    // "competitor_move" | "strategy_risk" | "alignment_drift" | "market_shift" | "action_required"
  severity    String    // "info" | "warning" | "critical"
  title       String
  message     String    @db.Text
  source      String?
  entityType  String?
  entityId    String?
  isRead      Boolean   @default(false)
  isDismissed Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([severity])
}

// ============================================
// SESSION CONTINUITY
// ============================================

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String?
  pillar    String?  // "vision" | "strategy" | "tactics" | "general"
  agent     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId])
  @@index([isActive])
}

// ============================================
// BRAIN GRAPH (Big Picture Visual Brain Map)
// ============================================

model BrainNode {
  id          String   @id @default(cuid())
  userId      String

  // What it is
  type        String   // "vision" | "goal" | "persona" | "need" | "decision" | "initiative" | "risk" | "market_signal" | "agent_learning"
  title       String
  content     String   @db.Text   // human-readable, used in Big Picture UI
  summary     String   @default("") // one-line for map labels

  // Where it came from
  source      String   // "onboarding" | "notion" | "slack" | "jira" | "agent" | "manual"
  sourceUrl   String   @default("")
  sourceId    String   @default("") // external ID if from integration

  // Machine layer
  embedding   String   @default("[]") // vector as JSON string for RAG
  metadata    String   @default("{}") // extra structured data as JSON

  // Agent memory layer
  agentType   String   @default("global") // which agent owns this node
  confidence  Float    @default(1.0)

  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  relations   BrainRelation[] @relation("fromNode")
  relatedBy   BrainRelation[] @relation("toNode")

  @@unique([userId, type, title], name: "userId_type_title")
  @@index([userId, type])
  @@index([userId, source])
  @@index([userId, agentType])
}

model BrainRelation {
  id           String    @id @default(cuid())
  fromNodeId   String
  toNodeId     String
  relationType String    // "supports" | "contradicts" | "depends_on" | "created_by" | "related_to"
  strength     Float     @default(1.0)
  createdAt    DateTime  @default(now())

  fromNode     BrainNode @relation("fromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode       BrainNode @relation("toNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([fromNodeId, toNodeId, relationType])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model ProactiveInsight {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentType   String   // "strategy" | "risk" | "discovery" | "market" | "competitor"
  title       String
  content     String   @db.Text
  summary     String   @default("")
  priority    String   @default("medium") // "high" | "medium" | "low"
  status      String   @default("new")    // "new" | "read" | "dismissed" | "actioned"
  sourceType  String   @default("")       // "drift" | "competitor" | "market" | "risk"
  sourceId    String   @default("")       // ID of related record if any
  metadata    String   @default("{}")     // JSON stored as string — JSON.parse() on read
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, agentType])
  @@index([userId, createdAt])
}

model WatchTopic {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  query         String    @default("")
  isActive      Boolean   @default(true)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, isActive])
}

model AgentMessage {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  workflowId    String    @default("")  // groups messages in the same workflow run
  workflowType  String    @default("")  // "initiative_deep_dive" | "market_threat_response"
  stepIndex     Int       @default(0)   // 0=first agent, 1=second, etc.

  fromAgent     String    // "discovery" | "risk" | "strategy" | "communications" | "advisor" | "thinker"
  toAgent       String    // same options + "user" for final output
  messageType   String    // "finding" | "assessment" | "recommendation" | "draft" | "summary"

  payload       String    @default("{}") // JSON stored as string — JSON.parse() on read
  status        String    @default("pending") // "pending" | "processing" | "completed" | "failed"
  errorMessage  String    @default("")

  initiativeId  String    @default("") // linked initiative if applicable
  metadata      String    @default("{}") // JSON stored as string — JSON.parse() on read

  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  completedAt   DateTime?

  @@index([userId, workflowId])
  @@index([userId, toAgent, status])
  @@index([userId, initiativeId])
  @@index([workflowId, stepIndex])
}

// ============ Integration Connections (Sprint 5) ============
model IntegrationConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationType String    // "notion"|"linear"|"github"|"jira"|"confluence"|"slack"|"mixpanel"|"amplitude"|"ga4"
  status          String    @default("disconnected") // "connected"|"disconnected"|"error"
  displayName     String    @default("")
  lastSyncAt      DateTime?
  errorMessage    String    @default("")
  metadata        String    @default("{}") // JSON stored as string — JSON.parse() on read
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, integrationType])
  @@index([userId])
}

// ============ Product Verticals (Sprint Architecture) ============
model ProductVertical {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String   @default("")
  strategy    String   @default("")    // strategic rationale
  color       String   @default("#6366F1") // for visual coding
  icon        String   @default("")    // lucide icon name
  status      String   @default("active")  // "active" | "paused" | "archived"
  sortOrder   Int      @default(0)

  // Links to vision layer
  productMappingId String @default("") // link to Vision ProductMapping

  // Children
  initiatives  Initiative[]

  // Brain graph
  brainNodeId  String @default("")

  metadata    String   @default("{}") // JSON string — JSON.parse() on read
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name], name: "userId_name_vertical")
  @@index([userId])
  @@index([userId, status])
}
